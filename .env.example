# Server
PORT=3001
NODE_ENV=production

# MongoDB (used by API when running via docker-compose)
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=gate-closes

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT / Auth (set strong values in production)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_SECRET=change-me-in-production
REFRESH_TOKEN_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRY=7d

# Optional: mailer, etc.
# MAILER_TRANSPORT_HOST=
# MAILER_EMAIL=
# MAILER_PASSWORD=
